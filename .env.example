# Public configuration for the MentorLagbe client.
# Copy the values you need into .env.local and fill in real values there.
# Never commit .env.local or any other file containing real secrets.

# Base URL of the MentorLagbe Express API.
# Local development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Direct browser-to-ImgBB uploads (profile photo and tuition banner).
# Leave empty to disable uploads; the UI will show a configuration message.
NEXT_PUBLIC_IMGBB_API_KEY=
